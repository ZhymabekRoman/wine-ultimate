    /* The delegate the app hands to PrintTaskRequest.CreatePrintTask(); the print
     * system calls it to be handed the IPrintDocumentSource to print. */
    [uuid(6c2ca228-5cd6-4b3a-8663-f3b02dc9b4b4)]
    delegate HRESULT PrintTaskSourceRequestedHandler([in] PrintTaskSourceRequestedArgs *args);

