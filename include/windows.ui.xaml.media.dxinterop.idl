import "oaidl.idl";
import "dxgi.idl";

[
    object,
    uuid(f92f19d2-3ade-45a6-a20c-f6f1ea90554b),
    local,
    pointer_default(unique)
]
interface ISwapChainPanelNative : IUnknown
{
    HRESULT SetSwapChain([in] IDXGISwapChain *swapChain);
}

[
    object,
    uuid(d2521730-6d90-4ae7-af63-400949bf6b9d),
    local,
    pointer_default(unique)
]
interface ISwapChainPanelNative2 : ISwapChainPanelNative
{
    HRESULT SetSwapChainHandle([in] HANDLE swapChainHandle);
}
