        [contract(Windows.Foundation.UniversalApiContract, 1.0)] interface Windows.UI.Input.IPointerPointProperties2;
    }

    [
        contract(Windows.Foundation.UniversalApiContract, 1.0)
    ]
    enum GestureSettings
    {
        None                          = 0,
        Tap                           = 1,
        DoubleTap                     = 2,
        RightTap                      = 4,
        Drag                          = 8,
        ManipulationTranslateX        = 0x10,
        ManipulationTranslateY        = 0x20,
        ManipulationTranslateInertia  = 0x40,
        ManipulationRotate            = 0x80,
        ManipulationRotateInertia     = 0x100,
        ManipulationScale             = 0x200,
        ManipulationScaleInertia      = 0x400
    };

    struct ManipulationDelta
    {
        Windows.Foundation.Point Translation;
        FLOAT Scale;
        FLOAT Rotation;
        FLOAT Expansion;
    };

    struct ManipulationVelocities
    {
        Windows.Foundation.Point Linear;
        FLOAT Angular;
        FLOAT Expansions;
        FLOAT Scale;
    };

