        );
        HRESULT RequestTokenWithWebAccountAsync(
            [in] Windows.Security.Authentication.Web.Core.WebTokenRequest *request,
            [in] Windows.Security.Credentials.WebAccount *webAccount,
            [out, retval] Windows.Foundation.IAsyncOperation<Windows.Security.Authentication.Web.Core.WebTokenRequestResult *> **operation
