/*
 * The interfaces and runtime classes of the namespace live in
 * windows.applicationmodel.datatransfer.idl; this file names the classes that
 * windows.applicationmodel.dataexchange.dll - the dll Windows hosts the
 * namespace's implementation in - serves from its DllGetActivationFactory,
 * mirroring the module-name idl of windows.networking.pushnotifications.idl.
 */

#ifdef __WIDL__
#pragma winrt ns_prefix
#endif

import "windows.applicationmodel.datatransfer.idl";

namespace Windows.ApplicationModel.DataTransfer {
    runtimeclass Clipboard;
    runtimeclass ClipboardContentOptions;
    runtimeclass DataPackage;
    runtimeclass DataPackagePropertySet;
    runtimeclass DataPackagePropertySetView;
    runtimeclass DataPackageView;
    runtimeclass DataTransferManager;
    runtimeclass HtmlFormatHelper;
    runtimeclass ShareProvider;
    runtimeclass ShareUIOptions;
    runtimeclass StandardDataFormats;
}
