    [
        contract(Windows.Foundation.UniversalApiContract, 1.0)
    ]
    enum CryptographicPublicKeyBlobType
    {
        X509SubjectPublicKeyInfo = 0,
        Pkcs1RsaPublicKey        = 1,
        BCryptPublicKey          = 2,
        Capi1PublicKey           = 3,
        [contract(Windows.Foundation.UniversalApiContract, 1.0)]
        BCryptEccFullPublicKey   = 4,
    };

    [
        contract(Windows.Foundation.UniversalApiContract, 1.0)
