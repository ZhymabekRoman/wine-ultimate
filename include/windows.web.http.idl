import "inspectable.idl";
import "asyncinfo.idl";
import "eventtoken.idl";
import "windowscontracts.idl";
import "windows.foundation.idl";
import "windows.foundation.collections.idl";
import "windows.storage.streams.idl";

namespace Windows.Web.Http {
    typedef enum HttpCompletionOption {
        CompletionResponseContentRead   = 0,
        CompletionResponseHeadersRead   = 1
    } HttpCompletionOption;

    typedef enum HttpSource {
        HttpSourceConnection    = 0,
        HttpSourceLocalCache    = 1,
        HttpSourceNetwork       = 2
    } HttpSource;

    typedef enum HTTPVersion {
        HttpVersion10   = 0,
        HttpVersion11   = 1,
        HttpVersion20   = 2
    } HTTPVersion;

    typedef enum UnicodeEncoding {
        UnicodeEncodingUtf8         = 0,
        UnicodeEncodingUtf16        = 1,
        UnicodeEncodingUtf16LE      = 2,
        UnicodeEncodingUtf16BE      = 3
    } UnicodeEncoding;

    typedef enum HttpProgressStatus {
        HttpProgressStatusCreated               = 0,
        HttpProgressStatusDeferralRequested     = 1,
        HttpProgressStatusStartReceived         = 2,
        HttpProgressStatusResponseHeadersRead   = 3,
        HttpProgressStatusResponseRead          = 4,
        HttpProgressStatusSending               = 5,
        HttpProgressStatusSentRequestHeaders    = 6,
        HttpProgressStatusSentRequestContent    = 7,
        HttpProgressStatusRequestCompletedClose = 8,
        HttpProgressStatusRequestCompletedAbort = 9
    } HttpProgressStatus;

    typedef struct HttpProgress {
        UINT64 BytesReceived;
        UINT32 IncomingLength;
        UINT32 IncomingCorrelationVectorLength;
        UINT64 TotalBytesToReceive;
        UINT64 BytesSent;
        UINT64 TotalBytesToSend;
        enum HttpProgressStatus Status;
    } HttpProgress;

    namespace Headers {
        interface IHttpHeaderCollection;
        interface IHttpContentHeaderCollection;
        interface IHttpRequestHeaderCollection;
        interface IHttpResponseHeaderCollection;
    }

    namespace Filters {
        interface IHttpFilter;
        interface IHttpBaseProtocolFilter;
    }

    interface IHttpContent;
    interface IHttpMethod;
    interface IHttpMethodFactory;
    interface IHttpMethodStatics;
    interface IHttpClient;
    interface IHttpClient2;
    interface IHttpClientFactory;
    interface IHttpRequestMessage;
    interface IHttpRequestMessageFactory;
    interface IHttpResponseMessage;
    interface IHttpResponseMessageFactory;
    interface IHttpStringContentFactory;
    interface IHttpStreamContentFactory;
    interface IHttpTransportInformation;

    runtimeclass HttpBaseProtocolFilter;
    runtimeclass HttpClient;
    runtimeclass HttpContentHeaderCollection;
    runtimeclass HttpMethod;
    runtimeclass HttpRequestHeaderCollection;
    runtimeclass HttpRequestMessage;
    runtimeclass HttpResponseMessage;
    runtimeclass HttpResponseHeaderCollection;
    runtimeclass HttpStreamContent;
    runtimeclass HttpStringContent;

