    [uuid("7fda1151-3574-4880-a8ba-e6b1e0061f3d")]
    interface IHttpClient : IInspectable
    {
        HRESULT DeleteAsync([in] Windows.Foundation.Uri *uri,
                            [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT GetAsync([in] Windows.Foundation.Uri *uri,
                         [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT GetAsync2([in] Windows.Foundation.Uri *uri, [in] HttpCompletionOption completionOption,
                          [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT GetBufferAsync([in] Windows.Foundation.Uri *uri,
                               [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Storage.Streams.IBuffer *, Windows.Web.Http.HttpProgress> **result);
        HRESULT GetInputStreamAsync([in] Windows.Foundation.Uri *uri,
                                    [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Storage.Streams.IInputStream *, Windows.Web.Http.HttpProgress> **result);
        HRESULT GetStringAsync([in] Windows.Foundation.Uri *uri,
                               [out, retval] Windows.Foundation.IAsyncOperationWithProgress<HSTRING, Windows.Web.Http.HttpProgress> **result);
        HRESULT PostAsync([in] Windows.Foundation.Uri *uri, [in] Windows.Web.Http.IHttpContent *content,
                          [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT PutAsync([in] Windows.Foundation.Uri *uri, [in] Windows.Web.Http.IHttpContent *content,
                         [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT SendRequestAsync([in] Windows.Web.Http.IHttpRequestMessage *request,
                                 [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        HRESULT SendRequestAsync2([in] Windows.Web.Http.IHttpRequestMessage *request, [in] HttpCompletionOption completionOption,
                                  [out, retval] Windows.Foundation.IAsyncOperationWithProgress<Windows.Web.Http.HttpResponseMessage *, Windows.Web.Http.HttpProgress> **result);
        [propget] HRESULT DefaultRequestHeaders([out, retval] Windows.Web.Http.Headers.IHttpRequestHeaderCollection **value);
    }

    [uuid("cdd83348-e8b7-4cec-b1b0-dc455fe72c92")]
    interface IHttpClient2 : IInspectable
    {
        HRESULT TryDeleteAsync([in] Windows.Foundation.Uri *uri,
                               [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TryGetAsync([in] Windows.Foundation.Uri *uri,
                            [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TryGetAsync2([in] Windows.Foundation.Uri *uri, [in] HttpCompletionOption completionOption,
                             [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TryGetBufferAsync([in] Windows.Foundation.Uri *uri,
                                  [out, retval] Windows.Foundation.IAsyncOperation<Windows.Storage.Streams.IBuffer *> **result);
        HRESULT TryGetInputStreamAsync([in] Windows.Foundation.Uri *uri,
                                       [out, retval] Windows.Foundation.IAsyncOperation<Windows.Storage.Streams.IInputStream *> **result);
        HRESULT TryGetStringAsync([in] Windows.Foundation.Uri *uri,
                                  [out, retval] Windows.Foundation.IAsyncOperation<HSTRING> **result);
        HRESULT TryPostAsync([in] Windows.Foundation.Uri *uri, [in] Windows.Web.Http.IHttpContent *content,
                             [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TryPutAsync([in] Windows.Foundation.Uri *uri, [in] Windows.Web.Http.IHttpContent *content,
                            [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TrySendRequestAsync([in] Windows.Web.Http.IHttpRequestMessage *request,
                                    [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
        HRESULT TrySendRequestAsync2([in] Windows.Web.Http.IHttpRequestMessage *request, [in] HttpCompletionOption completionOption,
                                     [out, retval] Windows.Foundation.IAsyncOperation<Windows.Web.Http.HttpResponseMessage *> **result);
    }

