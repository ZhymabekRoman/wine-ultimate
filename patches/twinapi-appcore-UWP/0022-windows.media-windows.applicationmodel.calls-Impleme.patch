+    case STREAM_SEEK_SET: new_pos = dlibMove.QuadPart; break;
+    case STREAM_SEEK_CUR: new_pos = impl->pos + dlibMove.QuadPart; break;
+    case STREAM_SEEK_END: new_pos = sizeof(struct bmp_image) + dlibMove.QuadPart; break;
