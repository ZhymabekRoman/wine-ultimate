+    BOOL (WINAPI *pPostMessageW)(HWND, UINT, WPARAM, LPARAM) = u32 ? (void *)GetProcAddress( u32, "PostMessageW" ) : NULL;
+    HWND core;
+    int i;
+    for (i = 0; i < 600; i++)
+    {
+        Sleep( 100 );
+        core = pFindWindowW ? pFindWindowW( L"Windows.UI.Core.CoreWindow", NULL ) : NULL;
+        if (core && pPostMessageW)
