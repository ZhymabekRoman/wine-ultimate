+}
+
+static HRESULT WINAPI d3d11_wrapper_Trim(IInspectable *iface)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI d3d11_wrapper_GetInterface(IInspectable *iface, REFIID iid, void **object)
+{
