#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma makedep po

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_OPTIONAL_FEATURES DIALOG 0, 0, 320, 260
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Windows Features"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "To turn a feature on, select its check box. To turn a feature off, clear its check box. A filled box means that only part of the feature is turned on.",
                    IDC_STATIC, 7, 7, 306, 24
    CONTROL         "", IDC_FEATURESLIST, "SysListView32",
                    LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,
                    7, 34, 306, 135
    GROUPBOX        "Description", IDC_STATIC, 7, 174, 306, 44
    LTEXT           "", IDC_DESCRIPTION, 14, 186, 292, 28
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 7, 222, 306, 12
    LTEXT           "", IDC_STATUS, 7, 240, 140, 14
    DEFPUSHBUTTON   "OK", IDOK, 154, 238, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 208, 238, 50, 14
    PUSHBUTTON      "Help", IDHELP, 262, 238, 51, 14, WS_DISABLED
END

1 RT_MANIFEST OptionalFeatures.manifest
